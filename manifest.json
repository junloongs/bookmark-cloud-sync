{
  "manifest_version": 3,
  "name": "书签云同步（WebDAV）",
  "version": "1.0.0",
  "description": "通过 WebDAV（坚果云等）在多个浏览器之间自动同步书签：支持双向合并、上传覆盖、下载覆盖与定时自动同步。",
  "minimum_chrome_version": "102",
  "permissions": ["bookmarks", "storage", "alarms", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "书签云同步",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
